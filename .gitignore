# See https://help.github.com/articles/ignoring-files/

# ==============================
# 📦 Dependencies
# ==============================
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build
/dist

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==============================
# 🔐 Local env files (DO NOT commit these!)
# ==============================
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# API Keys & Secrets
secrets.json
credentials.json

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Python Virtual Environments (백엔드 개발 시)
venv/
.venv/
**/venv/
**/.venv/
env/
ENV/
*.pyc
__pycache__/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Lock files (선택적 - 팀 정책에 따라)
# pnpm-lock.yaml
# package-lock.json
# yarn.lock

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# API Keys & Secrets (추가 보안)
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets.json
credentials.json

# Cache
.cache/
.parcel-cache/
